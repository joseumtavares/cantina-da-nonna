# EXEMPLO DE VARIÁVEIS DE AMBIENTE DO BANCO
# Copie este arquivo para .env quando quiser configurar credenciais locais.
# O .env real deve ficar fora do Git sempre que tiver senha, token ou chave privada.

# ==========================================================
# PERFIL LOCAL - XAMPP / MySQL ou MariaDB
# ==========================================================
# Use este perfil durante a aula e no desenvolvimento local.
spring.profiles.active=local
DB_URL=jdbc:mysql://127.0.0.1:3306/nona-db?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# ==========================================================
# PERFIL SUPABASE - PostgreSQL
# ==========================================================
# Para usar Supabase, troque spring.profiles.active para supabase
# e preencha os valores abaixo com os dados do painel do Supabase.
# Nunca envie senha real para o GitHub.

# Opção recomendada para desenvolvimento sem depender de IPv6: Session pooler.
# SUPABASE_DB_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres.bvkxyncjqoabipnlhtql
# SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO
# SUPABASE_SQL_INIT_MODE=always

# Opção Direct connection: pode exigir IPv6 ou o add-on de IPv4 dedicado no Supabase.
# SUPABASE_DB_URL=jdbc:postgresql://db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres
# SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO
# SUPABASE_SQL_INIT_MODE=always

# Depois que as tabelas já estiverem criadas no Supabase, podemos mudar:
# SUPABASE_SQL_INIT_MODE=never

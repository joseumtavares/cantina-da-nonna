# EXEMPLO DE VARIAVEIS DE AMBIENTE DO BANCO
# Copie este arquivo para .env se quiser usar valores locais sem alterar application.properties.
# O arquivo .env deve ficar fora do Git quando houver senha real.

# ==========================================================
# PERFIL LOCAL - XAMPP / MySQL ou MariaDB
# ==========================================================
# Use este perfil durante a aula e desenvolvimento local.
spring.profiles.active=local
DB_URL=jdbc:mysql://127.0.0.1:3306/nona-db?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# ==========================================================
# PERFIL SUPABASE - PostgreSQL
# ==========================================================
# Para usar Supabase, troque spring.profiles.active para supabase
# e preencha os valores abaixo com os dados do painel do Supabase.
#
# Nunca envie senha real para o GitHub.
#
# Opcao recomendada para desenvolvimento sem depender de IPv6: Session pooler.
# SUPABASE_DB_URL=jdbc:postgresql://aws-[REGIAO].pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres.[PROJECT_REF]
# SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO
# SUPABASE_SQL_INIT_MODE=always
#
# Opcao Direct connection: pode exigir IPv6 ou add-on de IPv4 dedicado no Supabase.
# SUPABASE_DB_URL=jdbc:postgresql://db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres
# SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO
# SUPABASE_SQL_INIT_MODE=always
#
# Depois que as tabelas ja estiverem criadas no Supabase, podemos mudar:
# SUPABASE_SQL_INIT_MODE=never